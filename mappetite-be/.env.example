# ============================================================
# Mappetite backend — environment template
# Copy this file to `.env` and fill in the values.
# NEVER commit the real `.env` file.
# ============================================================

# --- Database (Supabase Postgres) ---------------------------
# Supabase: Project Settings → Database → Connection string → "Transaction pooler" (port 6543)
# Example: postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
DATABASE_URL=
DB_POOL_MIN=1
DB_POOL_MAX=5

# --- Auth ---------------------------------------------------
# Random secret, minimum 32 characters. Generate one in PowerShell:
#   -join ((1..32) | ForEach-Object { '{0:x2}' -f (Get-Random -Max 256) })
JWT_SECRET=
JWT_ALGORITHM=HS256
JWT_EXPIRES_HOURS=24

# Google Cloud Console → Credentials → OAuth client ID (Web application).
# Only the Client ID is needed (no client secret). Leave empty to disable Google login.
GOOGLE_CLIENT_ID=

# --- CORS ---------------------------------------------------
# Comma-separated list of frontend origins allowed to call the API.
# Add your Vercel URL here after deploying, e.g. https://mappetite.vercel.app
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Reverse geocoding (Nominatim / OpenStreetMap) ----------
# Nominatim requires an identifying User-Agent (app name + contact URL or email).
NOMINATIM_USER_AGENT=Mappetite/0.1 (+https://github.com/4CeL/Mappetite)

# --- Server -------------------------------------------------
PORT=5000
# Number of reverse proxies in front of the app. Keep 0 locally, set 1 on Render
# so rate limiting sees the real client IP.
TRUST_PROXY_HOPS=0
# Rate-limit storage. memory:// is fine for a single instance.
RATELIMIT_STORAGE_URI=memory://
