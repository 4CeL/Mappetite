# ============================================================
# Mappetite frontend — environment template
# Copy this file to `.env.local` and fill in the values.
# NEXT_PUBLIC_* values are baked into the static build, so rebuild
# after changing them. Never put secrets here — they are public.
# ============================================================

# URL of the Flask backend (no trailing slash).
# Local: http://127.0.0.1:5000   Production: your Render URL, e.g. https://mappetite-be.onrender.com
NEXT_PUBLIC_API_URL=http://127.0.0.1:5000

# Google Cloud Console → Credentials → OAuth client ID (Web application).
# Must be the same Client ID as GOOGLE_CLIENT_ID in the backend.
# Leave empty to hide the "Sign in with Google" button.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Map tiles. The default OpenStreetMap server is fine for development only.
# For production use a provider with a free tier (CARTO, MapTiler, Stadia) and its attribution.
NEXT_PUBLIC_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
NEXT_PUBLIC_MAP_TILE_ATTRIBUTION=&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors
